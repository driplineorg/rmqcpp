@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# These are all PUBLIC dependencies of the rmq target, so their imported targets
# must exist before rmqcppTargets.cmake is included.  find_dependency() is used
# so that the REQUIRED/QUIET arguments given to find_package(rmqcpp) propagate.
find_dependency(bal)
find_dependency(OpenSSL)
find_dependency(ZLIB)
if(@ENABLE_COMPRESSION@)
    find_dependency(zstd CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rmqcppTargets.cmake")

check_required_components(rmqcpp)
